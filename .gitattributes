# Normalize line endings in repo
* text=auto

# Keep shell scripts LF (needed for hooks in CI/Linux)
*.sh text eol=lf
.husky/* text eol=lf

# Common text formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf